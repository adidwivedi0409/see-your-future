# Copy to .env and fill in only what you need. Everything works with DEMO_MODE=true and no keys.

# Cognee (Personal Brain) — optional
COGNEE_API_KEY=
COGNEE_BASE_URL=

# Bright Data (opportunity discovery) — optional
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_DATASET_ID=

# AWS / Strands (Future Navigator agent) — optional
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STRANDS_MODEL_ID=claude-sonnet-5
ANTHROPIC_API_KEY=

# App
DEMO_MODE=true
UPLOAD_MAX_MB=5
